# ============================================
# Liga de Fútbol — Backend Environment
# ============================================
# Copiá este archivo como `.env` y reemplazá los CHANGE_ME.
# No commitees el `.env` real (ya está en .gitignore).

# ---------- Aplicación ----------
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# ---------- Rate limiting (global por IP) ----------
# Ventana en ms y máximo de peticiones por ventana. Default: 100 req / 60s.
# (/auth/login tiene su propio límite estricto de 5/60s, fijo en el código.)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ---------- Base de datos ----------
# Embedded-postgres levanta una instancia local automáticamente.
# Si usás un PostgreSQL externo, pone USE_EMBEDDED_POSTGRES=false
# y ajustá DATABASE_URL a tu servidor.
USE_EMBEDDED_POSTGRES=true
# En WSL/Windows el data dir NO puede estar en /mnt/c (drvfs fuerza 0777 y
# PostgreSQL exige 0700/0750). Usá una ruta nativa de Linux, p.ej.:
#   EMBEDDED_PG_DATA_DIR=/home/<usuario>/.liga-futbol-pgdata
EMBEDDED_PG_DATA_DIR=../.pgdata
EMBEDDED_PG_PORT=5432
EMBEDDED_PG_USER=liga_user
EMBEDDED_PG_PASSWORD=CHANGE_ME

# Prisma: debe coincidir con la BD embebida (mismo user/password/port/db)
DATABASE_URL="postgresql://liga_user:CHANGE_ME@localhost:5432/liga_futbol?schema=public"

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h

# ---------- Bcrypt ----------
BCRYPT_ROUNDS=10

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ---------- Logs ----------
LOG_LEVEL=debug
