# ============================================
# Liga de Fútbol — variables para docker compose
# ============================================
# Copiá este archivo como `.env` (docker compose lo lee automáticamente):
#   cp .env.docker.example .env
# y reemplazá los CHANGE_ME. El `.env` real NO se commitea (está en .gitignore).

# ---------- PostgreSQL (servicio db) ----------
POSTGRES_USER=liga_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=liga_futbol

# ---------- Backend ----------
# Generá un secreto fuerte, p.ej.:  openssl rand -base64 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=log
MAX_FILE_SIZE_MB=10

# Sembrar la base sólo si está vacía (deja un usuario admin en el 1er arranque).
SEED_ON_EMPTY=true

# ---------- Frontend ----------
# URL de la API alcanzable DESDE EL NAVEGADOR (no desde el contenedor).
# Si exponés el backend en otro host/puerto, ajustá esto.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
